# Variáveis do deploy (docker-compose.prod.yml). No Dokploy, cole na aba Environment do projeto.
# Para rodar local: cp .env.example .env e troque TODOS os valores (Const. 5.3).
# Gere cada segredo com: openssl rand -hex 32
# URL interna do Postgres criado no Dokploy (aba Internal Credentials do banco).
DATABASE_URL=postgresql://USUARIO:SENHA@NOME-INTERNO-DO-BANCO:5432/BANCO
JWT_SECRET=troque-por-32+-bytes-aleatorios
PSEUDONYM_SECRET=troque-por-32+-bytes-aleatorios
RECEIPT_SECRET=troque-por-32+-bytes-aleatorios

# Chave Ed25519 PKCS#8 em PEM, em uma linha com \n no lugar das quebras.
# Gerar: uv run --directory backend python -m scripts.keygen
# Vazia: a API gera uma e guarda no volume `storage` (funciona, mas fica ao lado da testemunha).
AUDIT_PRIVATE_KEY_PEM=

# Conta do admin (leiloeiro), criada na primeira subida se não existir. O login é por usuário.
# Usuário: 3 a 32 caracteres (letras, números, _ e -), sem diferenciar maiúsculas.
# A senha não é trocada se a conta já existe; para trocar, altere pelo banco.
ADMIN_USERNAME=admin_ednan
ADMIN_PASSWORD=troque-por-senha-forte-min-8

THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json/123
CATALOG_TTL_HOURS=24
